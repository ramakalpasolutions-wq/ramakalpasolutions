# Copy this file to .env.local and fill in the values.

# --- Lead emails (Nodemailer over SMTP) ---
# Your domain's mail is on Hostinger, so these are Hostinger's SMTP settings.
# Use a mailbox you created in Hostinger (hPanel → Emails) and its password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# true for port 465 (SSL). Use 587 with SMTP_SECURE=false for STARTTLS.
SMTP_SECURE=true
SMTP_USER=customersupport@ramakalpasolutions.in
SMTP_PASS=

# Where leads are delivered (comma-separate for several). Defaults to SMTP_USER.
LEAD_TO_EMAIL=customersupport@ramakalpasolutions.in
# Optional sender name/address. Must be the SMTP_USER mailbox or Hostinger rejects it.
# Defaults to: Ramakalpa Website <SMTP_USER>
LEAD_FROM_EMAIL=

# Optional: Google Apps Script web-app URL that appends each lead to a Google Sheet
SHEETS_WEBHOOK_URL=

# Optional: overrides the Google Analytics 4 ID set in src/config/site.ts (G-M68PF9PNB7)
NEXT_PUBLIC_GA_ID=
