# Copy this file to .env.local and fill in the values.

# Resend (https://resend.com) – sends each lead to your inbox
RESEND_API_KEY=
# Where leads are delivered
LEAD_TO_EMAIL=customersupport@ramakalpasolutions.in
# Sender address. Must be on a domain you verified in Resend.
# Until then you can use: Ramakalpa Leads <onboarding@resend.dev>
LEAD_FROM_EMAIL=Ramakalpa Website <leads@ramakalpasolutions.in>

# Optional: Google Apps Script web-app URL that appends each lead to a Google Sheet
SHEETS_WEBHOOK_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
